# ---- Helpers ----
has_data <- function(df) !is.null(df) && nrow(df) > 0
fc_num <- function(fc, col, flt){
if(!col %in% colnames(fc)) return(NA_real_)
val <- suppressWarnings(as.numeric(fc[[col]][flt]))
if(length(val) == 0) NA_real_ else val
}
