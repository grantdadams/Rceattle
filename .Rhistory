# Load data ----
ebs_pollock <- Rceattle::read_data( file = "bsp0.xlsx")
ebs_pollock$estDynamics = 0
ebs_pollock$index_data$Log_sd <- ebs_pollock$index_data$Log_sd/ebs_pollock$index_data$Observation
